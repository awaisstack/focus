# ============================================================================
# FOCUS SANCTUARY — ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env.local and insert your personal AMD Token Factory key.
# NEVER commit .env.local or real API keys to Git.
# ============================================================================

# Server-only AMD Token Factory Bearer API Key
AMD_TOKEN_FACTORY_API_KEY=put_your_key_here

# Official shared OpenAI-compatible AMD Token Factory base endpoint
AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# Preferred model priority order (comma-separated, verified dynamically against /models)
AMD_PREFERRED_MODELS=Gemma-4-31B-IT,DeepSeek-V4.1-Flash,Qwen3.8-Flash-Next

# Request timeout in milliseconds for hosted inference before fallback
AMD_REQUEST_TIMEOUT_MS=12000
